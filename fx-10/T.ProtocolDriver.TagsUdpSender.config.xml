<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>UDP Sender for Tag Data Exchange</Description>
	<AssemblyName>T.ProtocolDriver.TagsUdpSender</AssemblyName>
	<AssemblyVersion>1.0.0.7</AssemblyVersion>
	<AllowUserTypes>true</AllowUserTypes>
	<AllowNoArrayIndexesForArray>true</AllowNoArrayIndexesForArray>
	<UseLastArrayPosition>true</UseLastArrayPosition>
	<EnableWriteGroup>true</EnableWriteGroup>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<UDP>
			<DefaultValues P1="false" P2="false" P3="3120" P4="1"/>
			<EditModes P1="Hidden" P2="Hidden" P3="Hidden" P4="Enable" />
		</UDP>
	</Settings>
	<Station>
		<UDP>
			<Names P1="Host" P2="Port" />
			<DefaultValues P1="127.0.0.1" P2="3120"/>
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="string" P2="int" />
			<Hint P1="Host" P2="Port number" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="290" G2="180" />
		</UDP>
	</Station>
	<Points>
		<Address AllowConfigDataType="true">
			<Names P1="Address"/>
			<DefaultValues P1=""/>
			<EditTypes P1="string"/>
			<EditModes P1="Enable"/>
			<Hint P1="Address" />
		</Address>
		<Modifiers>
			<EditModes P1="Optional" P2="Hidden" P3="Hidden" P4="Hidden" P5="Optional" />
		</Modifiers>
	</Points>
</Protocol>