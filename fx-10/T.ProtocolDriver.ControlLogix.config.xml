<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>AB Rockwell ControlLogix and CompactLogix devices</Description>
	<AssemblyName>T.ProtocolDriver.ControlLogix</AssemblyName>
	<AssemblyVersion>1.9.1.6</AssemblyVersion>
	<AllowUserTypes>true</AllowUserTypes>
	<AllowNoArrayIndexesForArray>true</AllowNoArrayIndexesForArray>
	<ShouldCloseCommAPIAfterErrors>true</ShouldCloseCommAPIAfterErrors>
	<Multiplatform>true</Multiplatform>
	<TagProvider Enable="true" BranchSeparator="." AttributeSeparator="." Access="ReadWrite" />
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="Model" P2="MaxStringItemsPerBlock" P3="WaitingBetweenMsgs" P4="StringLegacy" />
			<EditTypes P1="ComboBox=Others;1756-L8X;Micro850;" P2="3" P3="0" P4="0" />
			<EditModes P1="Enable" P2="Enable" P3="Enable" P4="Enable" />
			<DefaultValues P1="Others" P2="3" P3="0" P4="0" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="400" G2="300" />
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
			<DefaultValues P1="false" P2="false" P3="0" P4="1" />
			<EditModes P1="Hidden" P2="Hidden" P3="Hidden" P4="Enable" />
		</TCPIP>
	</Settings>
	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port" P3="Slot" />
			<DefaultValues P1 ="192.168.1.1" P2="44818" P3="0" />
			<EditModes P1="Enable" P2="Disable" P3="Enable" />
			<EditTypes P1="ip" P2="int" P3="int" />
			<Hint P1="IP Address" P2="TCP/IP Port" P3="Slot Number" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90" />
		</TCPIP>
	</Station>
	<Points>
		<Address AllowConfigDataType="false">
			<Names P1="Type" P2="separator1"  P3="DeviceTagName" />
			<DefaultValues P1="DINT" P2=":" P3="TAGNAME" />
			<EditTypes P1="ComboBox=BOOL;SINT;INT;DINT;REAL;STRING;DATATYPE;" P2="separator" P3="string" />
			<EditModes P1="Enable" P2="Hidden" P3="Enable" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="350" G2="140" />
			<Hint P1="" P2="The real device tag name as it is written there." />
		</Address>
	</Points>
</Protocol>