<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>Omron Hostlink Master</Description>
	<AssemblyName>T.ProtocolDriver.OmronHostLink</AssemblyName>
	<AssemblyVersion>1.1.0.0</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="BlockSize" P2="Ignore Non Critical Errors" P3="Change the PC mode for Writings" />
			<EditTypes P1="int=" P2="CheckBox" P3="CheckBox"/>
			<DefaultValues P1="29" P2="false" P3="true"/>
			<EditModes P1="Enable" P2="Enable" P3="Enable"/>
			<Hint P1="Maximum size of the read blocks\r\nRange: 0-29 words (ASCII)" P2="Ignore non critical communication errors" P3="Change the PLC to Monitor state
so the writing commands can be peformed"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="320" G2="230" />
		</ProtocolOptions>
	</ProtocolOptions>

	<Settings AllowCustomTypes="false">
		<Serial>
			<DefaultValues P1="false" P2="false" P3="com1" P4="19200" P5="7" P6="2" P7="even" P8="DtrOff" P9 = "RtsOff" />
			<EditModes P1="Hidden" P2="Hidden" P3="Enable" P4="Enable" P5="Enable" P6="Enable" P7="Enable" P8="Enable" P9 = "Enable"/>
		</Serial>
		<MultiSerial>
			<DefaultValues P1="false" P2="false" P3="2" P4="19200" P5="7" P6="2" P7="odd" />
			<EditModes P1="Hidden" P2="Hidden" P3="Enable" P4="Enable" P5="Enable" P6="Enable" P7="Enable"/>
		</MultiSerial>
	</Settings>

	<Timeout>
		<Timeout>
			<DefaultValues P1="1000" P2="1000" P3="1000" P4="500" P5="1" />
			<EditModes P1="Optional" P2="Optional" P3="Optional" P4="Optional" P5="Optional"/>
		</Timeout>
	</Timeout>

	<Station>
		<Serial>
			<Names P1="Unit Number"  />
			<EditTypes P1="int=0-126" />
			<DefaultValues P1="0" />
			<EditModes P1="Enable" />
			<Hint P1="Device unit number" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="250" G2="160" />
		</Serial>
		<MultiSerial>
			<Names P1="ComPort" P2="Unit Number" />
			<DefaultValues P1="com1" P2="0" />
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="LabelBox=com1;com2;com3;com4;com5;com6;com7;com8;" P2="int=0-127"/>
			<Hint P1="Serial port identification" P2="Device unit number"/>
		</MultiSerial>
	</Station>
	<Points>
		<Address AllowConfigDataType="true" >
			<Names P1="Memory Area" P2="" P3="Address" />
			<DefaultValues P1="DM" P2=":" P3="0"/>
			<EditTypes P1="ComboBox=IR:Internal Relay Bit Area;HR:Holding Bit Area;AR:Auxiliary Relay Bit Area;LR:Link Relay Area;DM:Data Memory Area;PV:Timer/Counter Present Value Area;TC:Timer/Counter Status Area;" P2="Separator" P3="int=0-1999"/>
			<EditModes P1="Enable" P2="Hidden" P3="Enable"/>
			<Hint
				  P1="IR	Internal Relay Bit Area 
HR	Holding Relay Bit Area
AR	Auxiliary Relay Bit Area 
LR  Link Relay Area 
DM  Data Memory Area 
PV  Timer/Counter Present Value Area
TC  Timer/Counter Status Area
"
				  P2=""
				  P3="Address from 0 to 1999, maximum address value varies with Type and plc model"
			/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="200" G2="120" />
		</Address>

	</Points>
	<Errors
	  P0="0;OK - No errors"
	  P1="1;Not executable in RUN mode"
	  P2="2;Not executable in MONITOR mode"
	  P3="4;Address over (CPM1 PlCs)"
	  P4="5;Invalid Header"
	  P5="6;Invalid Address"
	  P6="7;Invalid block size"
	  P7="11;Not executable in PROGRAM mode"
	  P8="19;FCS error"
	  P9="20;Format error"
	  P10="21;Entry number data error"
	  P11="22;Command not supported"
	  P12="24;Frame length error"
	  P13="25;Not executable"
	  P14="35;User memory write-protected"
	  P15="163;Aborted due to FCS error in transmit data"
  />
</Protocol>