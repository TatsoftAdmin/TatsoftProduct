<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>Genisys and Microlok plus</Description>
	<AssemblyName>T.ProtocolDriver.Genisys</AssemblyName>
	<AssemblyVersion>1.3.3.8</AssemblyVersion>
	<LocalPortEqualToRemotePort>true</LocalPortEqualToRemotePort>
	<EnableWriteGroup>true</EnableWriteGroup>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<Serial>
			<DefaultValues P1="false" P2="false" P3="com1" P4="9600" P5="8" P6="1" P7="even" />
			<EditModes P1="Hidden" P2="Enable" P3="Enable" P4="Enable" P5="Enable" P6="Enable" P7="Enable" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues P1="210" P2="120" />
		</Serial>
		<MultiSerial>
			<DefaultValues P1="false" P2="false" P3="2" P4="9600" P5="8" P6="1" P7="even" />
			<EditModes P1="Hidden" P2="Hidden" P3="Enable" P4="Enable" P5="Enable" P6="Enable" P7="Enable" />
		</MultiSerial>
		<TCPIP>
			<DefaultValues P1="false" P2="false" P3="502" P4="1" />
			<EditModes P1="Hidden" P2="Enable" P3="Enable" P4="Hidden" />
		</TCPIP>
		<UDP>
			<DefaultValues P1="false" P2="false" P3="502" P4="1" />
			<EditModes P1="Enable" P2="Enable" P3="Enable" P4="Hidden" />
		</UDP>
	</Settings>
	<Station>
		<Serial>
			<Names P1="SlaveID" P2="Recall" P3="SecurePolls" />
			<EditTypes P1="int=0-247" P2="int" P3="CheckBox" />
			<DefaultValues P1="1" P2="5" P3="false" />
			<EditModes P1="Enable" P2="Enable" P3="Enable" />
			<Hint P1="Destination slave ID" P2="Send Recall n Poll cycle" P3="Send CheckSums in Polls" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="250" G2="120" />
		</Serial>
		<TCPIP>
			<Names P1="IP" P2="Port" P3="SlaveID" P4="Recall" P5="SecurePolls" />
			<EditTypes P1="ip" P2="int" P3="int=0-247" P4="int" P5="CheckBox" />
			<DefaultValues P1 ="192.168.1.1" P2="502" P3="1" P4="0" P5="false" />
			<EditModes P1="Enable" P2="Enable" P3="Enable" P4="Enable" P5="Enable" />
			<Hint P1="IP Address" P2="TCP/IP Port" P3="Destination slave ID" P4="Send Recall n Poll cycle" P5="Send CheckSums in Polls" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="250" G2="120" />
		</TCPIP>
		<UDP>
			<Names P1="IP" P2="Port" P3="SlaveID" P4="Recall" P5="SecurePolls" />
			<EditTypes P1="ip" P2="int" P3="int=0-247" P4="int" P5="CheckBox" />
			<DefaultValues P1 ="192.168.1.1" P2="502" P3="1" P4="5" P5="false" />
			<EditModes P1="Enable" P2="Enable" P3="Enable" P4="Enable" P5="Enable" />
			<Hint P1="IP Address" P2="TCP/IP Port" P3="Destination slave ID" P4="Send Recall n Poll cycle" P5="Send CheckSums in Polls" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="250" G2="120" />
		</UDP>
	</Station>
	<Points>
		<Address>
			<Names P1="Type" P2="Address" />
			<DefaultValues P1="I" P2="1" />
			<EditTypes P1="ComboBox=I:Indicator;C:Control;"  P2="int" />
			<EditModes P1="Enable" P2="Enable" />
			<Hint P1="I   Indicator
                C   Control" P2="Address" />
		</Address>
	</Points>
</Protocol>