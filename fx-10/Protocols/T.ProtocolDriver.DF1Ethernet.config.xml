<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>AB Rockwell PLC5 and SLC</Description>
	<AssemblyName>T.ProtocolDriver.DF1Ethernet</AssemblyName>
	<AssemblyVersion>1.4.0.3</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<CustomInterface>TCPIP</CustomInterface>
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="Interface" P2="Protocol" P3="Model"/>
			<EditTypes P1="string" P2="string" P3="ComboBox=5;500;" />
			<EditModes P1="Disable" P2="Disable" P3="Enable"/>
			<DefaultValues P1="TCP/IP" P2="DF1" P3="500"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="180" G2="90"/>
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
		</TCPIP>
	</Settings>
	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port" />
			<DefaultValues P1 ="192.168.1.1" P2="2222" />
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="ip" P2="int" />
			<Hint P1="IP Address of the slave" P2="TCP/IP Port of the slave"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90" />
		</TCPIP>
	</Station>

	<Points>
		<Address AllowConfigDataType="true">
			<Names P1="FileType" P2="FileNumber" P3="" P4="Address" P5="Parameter"/>
			<DefaultValues P1="N" P2="" P3=":" P4="0" P5=""/>
			<EditTypes P1="ComboBox=N:Integer;B:Binary;T:Timer;C:Counter;R:Control;F:Float;O:Output;I:Input;S:Status;PD:PID;"
					   P2="int" P3="Separator" P4="int" P5="String"/>
			<EditModes P1="Enable" P2="Optional" P3="Hidden" P4="Enable" P5="Optional"/>
			<Hint P1="N	Integer
B	Binary
T	Timer
C	Counter
R	Control
F	Float
O	Output
I	Input
S	Status
PD PID"
				  P2="Address File" P3="" P4="Address Element" P5="Advanced Parameter"/>

			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="300" G2="135" />
			/>
		</Address>
	</Points>
</Protocol>