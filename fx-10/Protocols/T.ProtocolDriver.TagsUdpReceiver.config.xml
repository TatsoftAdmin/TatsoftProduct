<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>UDP Receiver for Tag Data Exchange</Description>
	<AssemblyName>T.ProtocolDriver.TagsUdpReceiver</AssemblyName>
	<AssemblyVersion>1.0.0.7</AssemblyVersion>
	<AllowUserTypes>true</AllowUserTypes>
	<AllowNoArrayIndexesForArray>true</AllowNoArrayIndexesForArray>
	<Multiplatform>true</Multiplatform>
	<UseLastArrayPosition>true</UseLastArrayPosition>
	<ProtocolOptions>
		<ProtocolOptions>
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<UDP>
			<DefaultValues P1="true" P2="false" P3="3120" P4="1"/>
			<EditModes P1="Disable" P2="Hidden" P3="Enable" P4="Disable" />
		</UDP>
	</Settings>
	<Points>
		<Address AllowConfigDataType="true">
			<Names P1="Address"/>
			<DefaultValues P1=""/>
			<EditTypes P1="string"/>
			<EditModes P1="Enable"/>
			<Hint P1="Address" />
		</Address>
		<Modifiers>
			<EditModes P1="Optional" P2="Hidden" P3="Hidden" P4="Hidden" P5="Optional" />
		</Modifiers>
	</Points>
</Protocol>