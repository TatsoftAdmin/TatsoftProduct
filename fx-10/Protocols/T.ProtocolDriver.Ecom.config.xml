<?xml version="1.0" encoding="utf-8"?>
<Protocol>
  <Description>Automation Direct Koyo</Description>
  <AssemblyName>T.ProtocolDriver.Ecom</AssemblyName>
  <AssemblyVersion>1.2.2.0</AssemblyVersion>
  <Multiplatform>true</Multiplatform>
  <ProtocolOptions>
    <ProtocolOptions>
      <Names P1="BlockSize"/>
      <EditTypes P1="int"/>
      <EditModes P1="Disable"/>
      <DefaultValues P1="255"/>
	    <Hint P1="Maximum size of the read blocks"/>
    </ProtocolOptions>
   </ProtocolOptions>
  
  <Settings AllowCustomTypes="false">
    <TCPIP>      
      <DefaultValues P1="false" P2="false" P3="0" P4="1"/>
      <EditModes P1="Hidden" P2="Hidden" P3="Hidden" P4="Disable"/>      
    </TCPIP>
    <UDP>
      <DefaultValues P1="false" P2="false" P3="0" P4="1"/>
      <EditModes P1="Hidden" P2="Hidden" P3="Hidden" P4="Disable" />
    </UDP>
  </Settings>
  <Station>    
    <TCPIP>
      <Names P1="IP" P2="Port" P3="SlaveID" />
      <DefaultValues P1 ="192.168.1.1" P2="28784" P3="1" />
      <EditModes P1="Enable" P2="Enable" P3="Enable"/>
      <EditTypes P1="ip" P2="int" P3="int" />
	    <Hint P1="IP Address of the slave" P2="UDP Port of the slave" P3="PLC ID"/>	  
      <SingleNode P1="true" />
    </TCPIP>
    <UDP>
      <Names P1="IP" P2="Port" P3="SlaveID" />
      <DefaultValues P1 ="192.168.1.1" P2="28784" P3="0" />
      <EditModes P1="Enable" P2="Enable" P3="Enable"/>
      <EditTypes P1="ip" P2="int" P3="int=" />
      <Hint P1="IP Address of the slave" P2="TCP/IP Port of the slave" P3="Destination slave address"/>
    </UDP>
    
  </Station>
  
  <Points>
    <Address AllowConfigDataType="true">
      <Names P1="Type" P2="OctalNumber" />
      <DefaultValues P1="V" P2="0"/>	
	  <EditTypes P1="ComboBox=C:Control Relays;CT:Control Status;SP:Special Relays;S:Stages;T:Timer Status;Y:Output Points;X:Input Points;V:Memory;"
				 P2="int"/>
      <EditModes P1="Enable" P2="Enable"/>
      <Hint P1="Ranges:\r\n
C	Control Relays	(0–1777)
CT	Control Status	(0-177)
SP	Special Relays	(0-777
S	Stages		(0-1777)
T	Timer Status	(0-377)
Y	Output Points	(0-777)
X	Input Points	(0-777)
V	Memory		(0-41237)"
			P2="Address in octal format"/>		
    </Address>
  </Points>
</Protocol>
