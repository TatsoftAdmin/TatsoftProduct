<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>ASCII Generic ASCII Master Protocol</Description>
	<AssemblyName>T.ProtocolDriver.ASCII</AssemblyName>
	<AssemblyVersion>1.2.0.0</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="BlockSize" P2="StartChar" P3="EndChar"/>
			<EditTypes P1="int" P2="int=0-255" P3="int=0-255"/>
			<DefaultValues P1="250" P2="" P3="" />
			<EditModes P1="Enable" P2="Enable" P3="Enable"/>
			<Hint P1="Max message size" P2="Start Char (decimal code)" P3="End Char(decimal code)"/>
			<GridProperties G1="PopUpWidth"  />
			<GridValues G1="290"  />
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
			<DefaultValues P1="false" P2="false" P3="502" P4="1"/>
			<EditModes P1="Hidden" P2="Enable" P3="Enable" P4="Enable" />
		</TCPIP>
		<Serial>
			<DefaultValues P1="false" P2="false" P3="com1" P4="9600" P5="8" P6="1" P7="none" />
			<EditModes P1="Enable" P2="Enable" P3="Enable" P4="Enable" P5="Enable" P6="Enable" P7="Enable" />
		</Serial>
	</Settings>

	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port" />
			<DefaultValues P1 ="192.168.1.1" P2="60001" />
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="ip" P2="int" />
			<Hint P1="IP Address of the SMQ" P2="TCP/IP Port of the SMQ"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90" />
		</TCPIP>
	</Station>
	<Points>
		<Address AllowConfigDataType="true" >
			<Names P1="SequenceID" P2="separator1" P3="SizeOf" />
			<DefaultValues P1="0" P2=":" P3="4"/>
			<EditTypes P1="int" P2="separator" P3="int"/>
			<EditModes P1="Enable" P2="Hidden" P3="Enable"/>
			<Hint
				  P1="Sequence ID"
				  P2=""
				  P3="Amount of characters from configured TAG"
			/>
		</Address>
	</Points>
</Protocol>