<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>Barcode Reader ASCII protocol</Description>
	<AssemblyName>T.ProtocolDriver.Barcode</AssemblyName>
	<AssemblyVersion>1.0.2.0</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="BlockSize" P2="StartChar" P3="EndChar"/>
			<EditTypes P1="int" P2="int=0-255" P3="int=0-255"/>
			<DefaultValues P1="256" P2="" P3="" />
			<EditModes P1="Enable" P2="Enable" P3="Enable"/>
			<Hint P1="Max message size" P2="Start Char" P3="End Char"/>
		</ProtocolOptions>
	</ProtocolOptions>

	<Timeout>
		<Timeout>
			<EditModes P1="Enable" P2="Enable" P3="Enable" P4="Enable" P5="Enable" />
		</Timeout>
	</Timeout>

	<Settings AllowCustomTypes="false">
		<Serial>
			<DefaultValues P1="true" P2="false" P3="com1" P4="9600" P5="8" P6="1" P7="even" />
			<EditModes P1="Enable" P2="Hidden" P3="Enable" P4="Enable" P5="Enable" P6="Enable" P7="Enable" />
		</Serial>
		<TCPIP>
			<EditModes P1="Disable" P2="Hidden" P3="Enable" P4="Disable"/>
			<DefaultValues P1="true" P2="false" P3="1432" P4="1"/>
		</TCPIP>
	</Settings>

	<Points>
		<Address AllowConfigDataType="true" >
			<Names P1="Bytes" />
			<DefaultValues P1="0"/>
			<EditTypes P1="int"/>
			<EditModes P1="Enable"/>
			<Hint P1="Number of bytes for this point
0 - means all bytes" />
		</Address>
	</Points>
</Protocol>