<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>Aesys VerbaInfo Service</Description>
	<AssemblyName>T.ProtocolDriver.VerbaInfo</AssemblyName>
	<AssemblyVersion>1.0.0.4</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="BlockSize" P2="StartChar" P3="EndChar"/>
			<EditTypes P1="int" P2="int=0-255" P3="int=0-255"/>
			<DefaultValues P1="250" P2="" P3="" />
			<EditModes P1="Enable" P2="Enable" P3="Enable"/>
			<Hint P1="Max message size" P2="Start Char (decimal code)" P3="End Char(decimal code)"/>
			<GridProperties G1="PopUpWidth"  />
			<GridValues G1="290"  />
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
			<DefaultValues P1="false" P2="false" P3="502" P4="1"/>
			<EditModes P1="Hidden" P2="Hidden" P3="Hidden" P4="Hidden" />
		</TCPIP>
	</Settings>

	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port" />
			<DefaultValues P1 ="192.168.1.1" P2="23608" />
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="ip" P2="int" />
			<Hint P1="IP Address of the VerbaInfo Server" P2="TCP/IP Port of the VerbaInfo Server"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90" />
		</TCPIP>
	</Station>
	<Points>
		<Address AllowConfigDataType="true" >
			<Names P1="Command" P2="separator1" P3="VMS" P4="separator1" P5="Code" P6="separator1" P7="Variable"/>
			<DefaultValues P1=" " P2=":" P3=" " P4=":" P5=" " P6=":" P7=" "/>
			<EditTypes P1="string" P2="separator" P3="string" P4="separator" P5="string" P6="separator" P7="string"/>
			<EditModes P1="Enable" P2="Hidden" P3="Enable" P4="Hidden" P5="Enable" P6="Hidden" P7="Enable"/>
			<Hint
				  P1="Command Type"
				  P2=""
				  P3="VMS Configured"
				  P4=""
				  P5="Code of Message"
				  P6=""
				  P7="Text of Message"
			/>
			<!--<Names P1="Command" P2="separator1" P3="VMS"/>
		<DefaultValues P1="ActivateTemplate" P2=":" P3="VMS"/>
		<EditTypes P1="string" P2="separator" P3="string"/>
		<EditModes P1="Enable" P2="Hidden" P3="Enable"/>
		<Hint
			  P1="Command Type"
			  P2=""
			  P3="VMS Configured"
	    	  />-->
		</Address>
	</Points>
</Protocol>