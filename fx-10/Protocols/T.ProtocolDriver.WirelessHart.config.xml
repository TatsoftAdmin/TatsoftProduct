<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>Emerson WirelessHart devices using HartIP protocol</Description>
	<AssemblyName>T.ProtocolDriver.WirelessHart</AssemblyName>
	<AssemblyVersion>2.0.0.8</AssemblyVersion>
	<Import>true</Import>
	<Multiplatform>true</Multiplatform>
	<AllowUserTypes>true</AllowUserTypes>
	<ShouldCloseCommAPIAfterErrors>true</ShouldCloseCommAPIAfterErrors>
	<ProtocolOptions>
		<ProtocolOptions>
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
		</TCPIP>
	</Settings>
	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port"/>
			<DefaultValues P1 ="192.168.1.1" P2="5094"/>
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="ip" P2="int"/>
			<Hint P1="IP Address" P2="TCP/IP Port"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90"/>
		</TCPIP>
	</Station>

	<Points>
		<Address AllowConfigDataType="false">
			<AssemblyName>T.ProtocolDriver.WirelessHart.Editors.AddressEditor.dll</AssemblyName>
			<TypeName>T.ProtocolDriver.WirelessHart.Editors.AddressEditor</TypeName>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="500" G2="300" />
		</Address>
	</Points>
</Protocol>