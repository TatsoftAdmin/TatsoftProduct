<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>OPC UA Client Driver</Description>
	<AssemblyName>T.ProtocolDriver.OPCUA</AssemblyName>
	<AssemblyVersion>1.0.0.21</AssemblyVersion>
	<Import>true</Import>
	<AllowUserTypes>true</AllowUserTypes>
	<AllowNoArrayIndexesForArray>true</AllowNoArrayIndexesForArray>
	<CustomInterface>Custom</CustomInterface>
	<EnableWriteGroup>false</EnableWriteGroup>
	<UseLastArrayPosition>true</UseLastArrayPosition>
	<Multiplatform>true</Multiplatform>
	<TagProvider Enable="true" BranchSeparator="\" AttributeSeparator="\" Access="ReadWrite" />
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="ReadGroupMaxSize" />
			<EditTypes P1="int=0-10000"/>
			<DefaultValues P1="100" />
			<EditModes P1="Enable" />
			<Hint P1="Maximum size for ReadGroups used in Runtime (when ReadPolling is enabled)"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="350" G2="150" />
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<Custom>
		</Custom>
	</Settings>
	<Station>
		<Custom>
			<AssemblyName>T.ProtocolDriver.OPCUA.Editors.dll</AssemblyName>
			<TypeName>T.ProtocolDriver.OPCUA.Editors.StationEditor</TypeName>
		</Custom>
	</Station>
	<Points>
		<Address AllowConfigDataType="false">
			<AssemblyName>T.ProtocolDriver.OPCUA.Editors.dll</AssemblyName>
			<TypeName>T.ProtocolDriver.OPCUA.Editors.AddressEditor;Static</TypeName>
		</Address>
		<Modifiers>
			<EditModes P1="Optional" P2="Hidden" P3="Hidden" P4="Hidden" P5="Optional" P6="Optional" />
		</Modifiers>
	</Points>
</Protocol>