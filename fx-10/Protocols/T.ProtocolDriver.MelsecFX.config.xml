<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>Mitsubishi Melsec FX</Description>
	<AssemblyName>T.ProtocolDriver.MelsecFX</AssemblyName>
	<AssemblyVersion>1.2.0.0</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="BlockSize"/>
			<EditTypes P1="int"/>
			<EditModes P1="Enable"/>
			<DefaultValues P1="128" />
			<Hint P1="Maximum size of blocks"  />
		</ProtocolOptions>
	</ProtocolOptions>

	<Settings AllowCustomTypes="false">
		<TCPIP>
			<DefaultValues P1="false" P2="false" P3="0" P4="1"/>
			<EditModes P1="Hidden" P2="Hidden" P3="Hidden" P4="Enable" />
		</TCPIP>
	</Settings>
	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port" />
			<DefaultValues P1 ="192.168.1.1" P2="5551" />
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="ip" P2="int" />
			<Hint P1="IP Address of the Device" P2="TCP Port of the Device"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90" />
		</TCPIP>
	</Station>

	<Points>
		<Address AllowConfigDataType="true">
			<Names P1="Operand" P2="Address" />
			<DefaultValues P1="M" P2="00001"/>
			<EditTypes P1="ComboBox=X: Input;Y: Output;M: Internal relay;B: Link relay;F: Annunciator;TN: Timer Current Value;TS: Timer Contacts;TC: Timer Coils;CN: Counter Current Value;CS: Counter Contacts;CC: Counter Coil;D: Data Registers;W: Link register;R: File register;"
					   P2="int"/>
			<EditModes P1="Enable" P2="Enable"/>
			<Hint
				  P1=""
				  P2=""
			/>

			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="320" G2="95" />
		</Address>
	</Points>
</Protocol>
