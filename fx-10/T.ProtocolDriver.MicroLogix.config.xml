<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<ShouldCloseCommAPIAfterErrors>true</ShouldCloseCommAPIAfterErrors>
	<Description>AB Rockwell MicroLogix</Description>
	<AssemblyName>T.ProtocolDriver.MicroLogix</AssemblyName>
	<AssemblyVersion>1.3.0.1</AssemblyVersion>
	<CompactFramework>true</CompactFramework>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
		</TCPIP>
	</Settings>
	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port"/>
			<DefaultValues P1 ="192.168.1.1" P2="44818"/>
			<EditModes P1="Enable" P2="Disable"/>
			<EditTypes P1="ip" P2="int"/>
			<Hint P1="IP Address" P2="TCP/IP Port"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90"/>
		</TCPIP>
	</Station>

	<Points>
		<Address AllowConfigDataType="true">
			<Names P1="FileType" P2="FileNumber" P3="" P4="Address"/>
			<DefaultValues P1="N" P2="7" P3=":" P4="0"/>

			<EditTypes P1="ComboBox=N:Integer;B:Binary;F:FloatPoint;O:OutputLogical;I:InputLogical;ST:String;S:Status;DLG:DataLogging;"
							 P2="int" P3="Separator"   P4="string"/>
			<EditModes P1="Enable" P2="Enable" P3="Hidden" P4="Enable"/>
			<Hint P1="N	Integer
B	Binary
F	FloatPoint
O	OutputLogical
I	InputLogical
ST	String
S	Status
DLG	DataLogging
"
				  P2="Address File" P3="" P4="Address"/>

			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="300" G2="135" />
			/>
		</Address>
	</Points>
</Protocol>