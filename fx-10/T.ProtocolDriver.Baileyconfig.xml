<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>Bailey INFI90 devices</Description>
	<AssemblyName>T.ProtocolDriver.Bailey</AssemblyName>
	<AssemblyVersion>4.0.1</AssemblyVersion>
	<AllowUserTypes>true</AllowUserTypes>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>

		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<Serial>
			<DefaultValues P1="false" P2="false" P3="com1" P4="9600" P5="7" P6="2" P7="even" />
			<EditModes P1="Hidden" P2="Hidden" P3="Enable" P4="Enable" P5="Enable" P6="Enable" P7="Enable" />
		</Serial>
	</Settings>

	<Station>
		<Serial>
			<Names P1="Ring" P2="Node" P3="Module"/>
			<DefaultValues P1 ="1" P2="35"  P3="2"/>
			<EditModes P1="Enable" P2="Enable" P3="Enable"/>
			<EditTypes P1="int" P2="int" P3="int"/>
			<Hint P1="Ring" P2="Node" P3="Module"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="200" G2="100" />
		</Serial>
	</Station>

	<Points>
		<Address AllowConfigDataType="false">
			<AssemblyName>T.ProtocolDriver.Bailey.Editors.AddressEditor.dll</AssemblyName>
			<TypeName>T.ProtocolDriver.Bailey.Editors.AddressEditor</TypeName>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="300" G2="300" />
		</Address>
	</Points>
</Protocol>