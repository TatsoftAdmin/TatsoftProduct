<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<Description>MQTT WEG - Message Queuing Telemetry Transport</Description>
	<AssemblyName>T.ProtocolDriver.MQTTWEG</AssemblyName>
	<AssemblyVersion>"1.0.0.12"</AssemblyVersion>
	<CustomInterface>Custom</CustomInterface>
	<AllowUserTypes>true</AllowUserTypes>
	<EnableWriteGroup>true</EnableWriteGroup>
	<Multiplatform>true</Multiplatform>
	<AllowNoArrayIndexesForArray>true</AllowNoArrayIndexesForArray>
	<ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<Custom>
			<EditModes P1="Hidden" P2="Hidden" P3="Hidden" P4="Hidden" P5="Hidden" />
		</Custom>
	</Settings>
	<Station>
		<Custom>
			<AssemblyName>T.ProtocolDriver.MQTTWEG.Editors.dll</AssemblyName>
			<TypeName>T.ProtocolDriver.MQTTWEG.Editors.StationEditor</TypeName>
		</Custom>
	</Station>

	<Points>
		<Address AllowConfigDataType="false">
			<Names P1="Topic" />
			<DefaultValues P1="Topic" />
			<EditTypes P1="string" />
			<EditModes P1="Enable" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="350" G2="auto" />
			<Hint P1="" P2="" />
		</Address>
	</Points>
</Protocol>