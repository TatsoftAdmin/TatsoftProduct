<?xml version="1.0" encoding="utf-8"?>
<Provider>
	<Description>Microsoft Excel 2003 Database</Description>
	<ConnectionString>
		<System.Data.Odbc>
			<Names P1="Driver" P2="DriverId" P3="Dbq" P4="Additional Parameters"/>
			<EditTypes P1="string" P2="string" P3="string" P4="string" />
			<DefaultValues P1="{Microsoft Excel Driver (*.xls)}" P2="790" P3="C:\ExcelWorksheet.xls" P4=""/>
			<EditModes P1="Disable" P2="Disable" P3="Enable" P4="Enable"/>
			<Hint P1="ODBC Driver name" P2="ODBC Driver ID" P3="Complete path to the xls file" P4="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="400" G2="170" />
		</System.Data.Odbc>
		<System.Data.OleDb>
			<Names P1="Provider" P2="Data Source" P3="Extended Properties" P4="Additional Parameters"/>
			<EditTypes P1="string" P2="string" P3="string" P4="string"/>
			<DefaultValues P1="Microsoft.Jet.OLEDB.4.0" P2="c:\" P3="&quot;Excel 8.0;HDR=Yes;IMEX=1&quot;" P4=""/>
			<EditModes P1="Disable"  P2="Enable" P3="Enable" P4="Enable"/>
			<Hint P1="Provider Name" P2="Path and fileName of dataSource" P3="Properties for this connection:
HDR=Yes indicates that the first row contains columnnames, not data
IMEX=1 indicates that the driver will treat data columns as text" P4="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="400" G2="170" />
		</System.Data.OleDb>
	</ConnectionString>
</Provider>
