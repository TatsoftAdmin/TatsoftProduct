<?xml version="1.0" encoding="utf-8"?>
<Provider>
  <Description>Oracle Database</Description>
  <ConnectionString>

    <System.Data.Odbc>
      <Names P1="Driver" P2="Server" P3="Uid" P4="Pwd" P5="Additional Parameters"/>
      <EditTypes P1="None"  P2="FileName"  P3="None" P4="Password" P5="string"/>
      <DefaultValues P1="{Microsoft ODBC for Oracle}" P2="myServerAddress"  P3="myUserName" P4="myPassword"/>
      <EditModes P1="Disable"  P2="Enable" P3="Enable" P4="Enable"/>
      <Hint P1="Driver Name" P2="server Name" P3="User Id" P4="Password"/>
	  <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
	  <GridValues G1="350" G2="90" />
    </System.Data.Odbc>

    <System.Data.OleDb>
      <Names P1="Provider" P2="Data Source" P3="Integrated Security" P4="Additional Parameters"/>
      <EditTypes P1="None"  P2="None" P3="None" P4="string"/>
      <DefaultValues P1="MSDAORA.1" P2="MyOracleDB" P3="no" P4=""/>
      <EditModes P1="Disable"  P2="Enable" P3="Enable" P4="Enable"/>
      <Hint P1="Provider Name" P2="Database Name" P3="Security Definition" P4="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
	  <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
	  <GridValues G1="390" G2="170" />
    </System.Data.OleDb>

    <System.Data.OracleClient>
      <Names P1="Data Source" P2="Integrated Security" P3="Additional Parameters"/>
      <EditTypes P1="None"  P2="None" P3="string"/>
      <DefaultValues P1="MyOracleDB" P2="no" P3=""/>
      <EditModes P1="Enable" P2="Enable" P3="Enable"/>
      <Hint P1="Database Name" P2="Security Definition" P3="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
	  <Parameters UserSyntax="User Id" PassSyntax="Password" />
      <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
	  <GridValues G1="390" G2="170" />
    </System.Data.OracleClient>

   <Oracle.DataAccess.Client>
      <Names P1="Data Source" P2="Additional Parameters"/>
      <EditTypes P1="None" P2="string" />
      <DefaultValues P1="//127.0.0.1:1521/OracleDB" P2=""/>
      <EditModes P1="Enable" P2="Enable"/>
      <Hint P1="Service Name or
//computer name or IP : TCP Port / Database Name"  P2="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
      <Parameters UserSyntax="User Id" PassSyntax="Password" />
      <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
      <GridValues G1="390" G2="170" />
    </Oracle.DataAccess.Client>

   <Oracle.ManagedDataAccess.Client>
      <Names P1="Data Source" P2="Additional Parameters"/>
      <EditTypes P1="None" P2="string"/>
      <DefaultValues P1="//127.0.0.1:1521/OracleDB" P2=""/>
      <EditModes P1="Enable" P2="Enable"/>
      <Hint P1="Service Name or
//computer name or IP : TCP Port / Database Name" P2="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
      <Parameters UserSyntax="User Id" PassSyntax="Password" />
      <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
      <GridValues G1="390" G2="170" />
    </Oracle.ManagedDataAccess.Client>


  </ConnectionString>
</Provider>