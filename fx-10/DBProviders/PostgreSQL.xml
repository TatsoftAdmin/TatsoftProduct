<?xml version="1.0" encoding="utf-8"?>
<Provider>
  <Description>PostgreSQL Database</Description>
  <ConnectionString>
    <Npgsql>
      <Names  P1="Server" P2="Port" P3="Database" P4="Additional Parameters"/>
      <EditTypes    P1="String" P2="String" P3="String" P4="String"  />
      <DefaultValues  P1="127.0.0.1" P2="5432" P3="myDatabase" P4=""/>
      <EditModes  P1="Enable" P2="Enable" P3="Enable" P4="Enable"/>
      <Hint P1="Server Location" P2="Port" P3="Database Name" P4="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"  />
	  <Parameters UserSyntax="User Id" PassSyntax="Password" />
	  <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
	  <GridValues G1="420" G2="170" />
    </Npgsql>
</ConnectionString>
</Provider>