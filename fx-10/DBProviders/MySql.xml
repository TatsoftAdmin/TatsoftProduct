<?xml version="1.0" encoding="utf-8"?>
<Provider>
  <Description>MySql Database</Description>
  <ConnectionString>

    <System.Data.Odbc>
      <Names P1="Driver" P2="Server" P3="Port" P4="Database" P5="Option" P6="Additional Parameters"/>
      <EditTypes P1="string"  P2="string" P3="int" P4="string" P5="int" P6="string"/>
      <DefaultValues P1="{MySQL ODBC 5.1 Driver}" P2="127.0.0.1" P3="3306" P4="mysql" P5="3" P6=""/>
      <EditModes P1="Enable"  P2="Enable" P3="Enable" P4="Enable" P5="Enable" P6="Enable"/>
      <Hint P1="ODBC driver name" P2="server name" P3="port number" P4="database name" P5="options" P6="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
      <Parameters UserSyntax="User" PassSyntax="Password" />
      <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
      <GridValues G1="420" G2="170" />
    </System.Data.Odbc>

    <MySql.Data.MySqlClient>
      <Names P1="Server" P2="Port" P3="Database" P4="SslMode" P5="Additional Parameters"/>
      <EditTypes P1="string" P2="int" P3="string" P4="ComboBox=None;Preferred;Required;" P5="string"/>
      <DefaultValues P1="127.0.0.1" P2="3306" P3="mysql" P4="None" P5=""/>
      <EditModes P1="Enable" P2="Enable" P3="Enable" P4="Enable" P5="Enable"/>
      <Hint P1="Server Name" P2="Port Number" P3="Database Name" P4="Ssl Mode. Use 'none' if not use SSL" P5="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
      <Parameters UserSyntax="Uid" PassSyntax="Pwd" />
      <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
      <GridValues G1="390" G2="170" />
    </MySql.Data.MySqlClient>

  </ConnectionString>
</Provider>