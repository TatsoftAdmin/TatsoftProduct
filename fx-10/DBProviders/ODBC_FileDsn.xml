<?xml version="1.0" encoding="utf-8"?>
<Provider>
  <Description>ODBC using FILEDSN</Description>
  <ConnectionString>
    <System.Data.Odbc>
      <Names P1="FILEDSN" P2="Additional Parameters"/>
      <EditTypes P1="string" P2="string"/>
      <DefaultValues P1="C:\Program Files\Common Files\ODBC\Data Sources\dataSource.dsn" P2=""/>
      <EditModes P1="Enable" P2="Enable"/>
      <Hint P1="Complete path to the dataSource.dsn, without the double quotes" P2="Aditional parameters to be added to the ConnectionString, separated by ',' (comma)"/>
      <GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
      <GridValues G1="600" G2="170" />
    </System.Data.Odbc>
  </ConnectionString>
</Provider>

