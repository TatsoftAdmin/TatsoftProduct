<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<ShouldCloseCommAPIAfterErrors>true</ShouldCloseCommAPIAfterErrors>
	<Description>CTC Binary Protocol 5300 model</Description>
	<AssemblyName>T.ProtocolDriver.CTC</AssemblyName>
	<AssemblyVersion>3.0.0.1</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
			<DefaultValues P1="false" P2="false" P3="502" P4="1"/>
			<EditModes P1="Hidden" P2="Enable" P3="Enable" P4="Enable" />
		</TCPIP>
	</Settings>

	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port"/>
			<DefaultValues P1 ="192.168.1.1" P2="6000"/>
			<EditModes P1="Enable" P2="Enable"/>
			<EditTypes P1="ip" P2="int"/>
			<Hint P1="IP Address of the slave" P2="Port of Controller"/>
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="230" G2="90" />
		</TCPIP>
	</Station>
	<Points>
		<Address AllowConfigDataType="true" >
			<Names P1="Type" P2="Number" />
			<DefaultValues P1="R" P2="0"/>
			<EditTypes P1="ComboBox=R:Register;AO:Analog Output;AI:Analog Input;F:Flag;DI:Digital Input;DO:Digital Output;VAR: Variant;BLKVAR: Variant Block" P2="Int"/>
			<EditModes P1="Enable" P2="Enable"/>
			<Hint
				  P1="
R	Register
AO	Analog Output
AI	Analog Input
F	Flag
DI	Digital Input
DO	Digital Output
VAR Variant
BLKVAR Variant Block"
				  P2="NUmber from 1 to 65535"
			/>
		</Address>
	</Points>
</Protocol>