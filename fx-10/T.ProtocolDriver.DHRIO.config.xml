<?xml version="1.0" encoding="utf-8"?>
<Protocol>
	<ShouldCloseCommAPIAfterErrors>true</ShouldCloseCommAPIAfterErrors>
	<Description>AB Rockwell PLC5 devices using 1756 DHRIO</Description>
	<AssemblyName>T.ProtocolDriver.DHRIO</AssemblyName>
	<AssemblyVersion>1.1.0.5</AssemblyVersion>
	<Multiplatform>true</Multiplatform>
	<ProtocolOptions>
		<ProtocolOptions>
			<Names P1="Interface" P2="Protocol" P3="Model" />
			<EditTypes P1="string" P2="string" P3="ComboBox=5;500;" />
			<EditModes P1="Disable" P2="Disable" P3="Enable" />
			<DefaultValues P1="TCP/IP" P2="DF1" P3="5" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="180" G2="90" />
		</ProtocolOptions>
	</ProtocolOptions>
	<Settings AllowCustomTypes="false">
		<TCPIP>
		</TCPIP>
	</Settings>
	<Station>
		<TCPIP>
			<Names P1="IP" P2="Port" P3="BackPlane" P4="DHRIO Slot" P5="DHRIO Channel" P6="DH+ Node" />
			<DefaultValues P1 ="192.168.1.1" P2="44818" P3="1" P4="2" P5="A" P6="0" />
			<EditModes P1="Enable" P2="Disable" P3="Enable" P4="Enable" P5="Enable" P6="Disable" />
			<EditTypes P1="ip" P2="int" P3="int" P4="int" P5="ComboBox=A;B;" P6="int" />
			<Hint P1="IP Address" P2="TCP/IP Port" P3="Slot of 1756-DHRIO" P4="Channel of 1756-DHRIO" />
			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="290" G2="150" />
		</TCPIP>
	</Station>

	<Points>
		<Address AllowConfigDataType="true">
			<Names P1="FileType" P2="FileNumber" P3="" P4="Address" P5="Parameter" />
			<DefaultValues P1="N" P2="" P3=":" P4="0" P5="" />
			<EditTypes P1="ComboBox=N:Integer;B:Binary;T:Timer;C:Counter;R:Control;F:Float;O:Output;I:Input;S:Status;"
				 P2="int" P3="Separator" P4="int" P5="String" />
			<EditModes P1="Enable" P2="Optional" P3="Hidden" P4="Enable" P5="Optional" />
			<Hint P1="N	Integer
						B	Binary
						T	Timer
						C	Counter
						R	Control
						F	Float
						O	Output
						I	Input
						S	Status
"
				   P2="Address File" P3="" P4="Address" />

			<GridProperties G1="PopUpWidth" G2="PropertyColumnWidth" />
			<GridValues G1="300" G2="135" /> />
		</Address>
	</Points>
</Protocol>